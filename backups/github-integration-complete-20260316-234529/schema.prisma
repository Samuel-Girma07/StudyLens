// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile       UserProfile?
  interactions  UserInteraction[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// USER PROFILE & PREFERENCES
// ============================================

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  subjects            String   // JSON array: ["programming", "mathematics"]
  formats             String   // JSON array: ["books", "articles", "videos"]
  experienceLevel     String   // "beginner" | "intermediate" | "advanced"
  timeCommitment      String   // "casual" | "moderate" | "intensive"
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// RESOURCES
// ============================================

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  author      String
  type        String   // "book" | "article" | "video"
  subject     String   // "programming" | "mathematics" | "science" | "languages" | "history" | "business"
  thumbnail   String?
  url         String
  difficulty  String   // "beginner" | "intermediate" | "advanced" | "expert"
  tags        String   // JSON array: ["javascript", "web-development"]
  likeCount   Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  interactions UserInteraction[]
}

// ============================================
// USER INTERACTIONS
// ============================================

model UserInteraction {
  id         String    @id @default(cuid())
  userId     String
  resourceId String
  rating     Int?      // 1 (like) | -1 (dislike) | null
  saved      Boolean   @default(false)
  viewed     Boolean   @default(false)
  savedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

// ============================================
// EXTERNAL API CACHES
// ============================================

model YouTubeCache {
  id          String   @id @default(cuid())
  query       String   @unique
  results     String   // JSON array of video results
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime
}

